{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Trusted Smarti chrome only. Remote browser WebViews match no capability and cannot invoke Tauri commands.",
  "webviews": ["main", "voice-overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "opener:allow-open-url",
    "updater:default"
  ]
}
