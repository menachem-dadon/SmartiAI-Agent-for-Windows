{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "Smarti Desktop Control Plane",
  "version": "2.0.0",
  "base_path": "/v2",
  "security": {
    "transport": "loopback-only",
    "authentication": "Authorization: Bearer <per-launch-token>",
    "allowed_origins": [
      "tauri://localhost",
      "http://tauri.localhost",
      "https://tauri.localhost"
    ],
    "secrets": "masked metadata only; plaintext is accepted only by explicit set/validate commands"
  },
  "requests": {
    "createWorkspace": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "root_path": {
          "type": "string",
          "maxLength": 32767
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "patchWorkspace": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "root_path": {
          "type": "string",
          "maxLength": 32767
        },
        "metadata": {
          "type": "object"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "createConversation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "workspace_id": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "patchConversation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "workspace_id": {
          "type": "string",
          "maxLength": 200
        },
        "pinned": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "submitRun": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 1000000
        },
        "attachment_handles": {
          "type": "array",
          "maxItems": 80,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "workspace_id": {
          "type": "string",
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "provider_mode": {
          "type": "string",
          "maxLength": 100
        },
        "model_name": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "markRead": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "resolveApproval": {
      "type": "object",
      "properties": {
        "approved": {
          "type": "boolean"
        }
      },
      "required": [
        "approved"
      ],
      "additionalProperties": false
    },
    "patchSettings": {
      "type": "object",
      "properties": {
        "values": {
          "type": "object",
          "minProperties": 1
        }
      },
      "required": [
        "values"
      ],
      "additionalProperties": false
    },
    "setSecret": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "legalAcceptance": {
      "type": "object",
      "properties": {
        "accepted": {
          "type": "boolean",
          "const": true
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "accepted",
        "version"
      ],
      "additionalProperties": false
    },
    "settingsAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "reset",
            "codex_status",
            "codex_check",
            "codex_login",
            "codex_logout",
            "email_test",
            "ssl_test",
            "ssl_import_ca",
            "log_clear"
          ]
        },
        "ssl_trust_mode": {
          "type": "string",
          "enum": [
            "system",
            "custom_ca",
            "legacy_insecure"
          ]
        },
        "ssl_custom_ca_path": {
          "type": "string",
          "maxLength": 32767
        },
        "source_path": {
          "type": "string",
          "maxLength": 32767
        },
        "confirmation": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "validateProvider": {
      "type": "object",
      "properties": {
        "secret": {
          "type": "string",
          "maxLength": 65536
        },
        "local_url": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "setModelReasoning": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "model",
        "effort"
      ],
      "additionalProperties": false
    },
    "registerAttachment": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767
        },
        "session_id": {
          "type": "string",
          "maxLength": 200
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 86400
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "startTts": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "provideRunApiKey": {
      "type": "object",
      "properties": {
        "secret_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": [
        "secret_key",
        "value"
      ],
      "additionalProperties": false
    },
    "taskAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "edit",
            "cancel",
            "retry",
            "resume",
            "delete"
          ]
        },
        "id": {
          "type": "string",
          "maxLength": 200
        },
        "prompt": {
          "type": "string",
          "maxLength": 100000
        },
        "delay_minutes": {
          "type": "number",
          "minimum": 0
        },
        "repeat": {
          "type": "string",
          "enum": [
            "once",
            "interval",
            "weekly"
          ]
        },
        "interval_minutes": {
          "type": "number",
          "minimum": 1
        },
        "days_of_week": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "conversation_mode": {
          "type": "string",
          "enum": [
            "current",
            "new",
            "dedicated"
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "memoryAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "details",
            "reveal",
            "edit",
            "pin",
            "archive",
            "restore",
            "delete"
          ]
        },
        "subject": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "maxLength": 6000
        },
        "category": {
          "type": "string"
        },
        "sensitivity": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "pinned": {
          "type": "boolean"
        },
        "memory_type": {
          "type": "string"
        },
        "ttl_hours": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "memoryCollectionAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "bulk_archive",
            "bulk_restore",
            "bulk_delete",
            "import",
            "export",
            "clear"
          ]
        },
        "ids": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "subject": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "maxLength": 6000
        },
        "category": {
          "type": "string"
        },
        "memory_type": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "ttl_hours": {
          "type": "number",
          "minimum": 0
        },
        "pinned": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "maxLength": 32767
        },
        "confirmation": {
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "toolAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "set_trust",
            "set_enabled",
            "refresh",
            "install_skill",
            "install_custom",
            "install_mcp",
            "delete"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "builtin",
            "custom",
            "mcp",
            "skill"
          ]
        },
        "name": {
          "type": "string"
        },
        "trusted": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "maxLength": 32767
        },
        "package": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "diagnosticAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "scan",
            "repair",
            "cancel"
          ]
        },
        "include_network": {
          "type": "boolean"
        },
        "repair_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "setWorkspaceRoot": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "openWorkspaceFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "terminalAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "write",
            "restart"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "canvasAction": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "layout",
            "close",
            "reopen"
          ]
        },
        "button_positions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "label": {
                "type": "string",
                "maxLength": 300
              },
              "x": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "y": {
                "type": "number",
                "minimum": -100000,
                "maximum": 100000
              },
              "width": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              },
              "height": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              }
            },
            "required": [
              "id",
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "browserImport": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "history": {
          "type": "boolean"
        },
        "bookmarks": {
          "type": "boolean"
        },
        "cookies": {
          "type": "boolean"
        }
      },
      "required": [
        "source_id"
      ],
      "additionalProperties": false
    },
    "legacyBrowserMigration": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "applied"
          ]
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  "operations": [
    {
      "method": "GET",
      "path": "/v2/health",
      "operation_id": "health",
      "summary_he": "בדיקת חיות מינימלית",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/version",
      "operation_id": "version",
      "summary_he": "גרסת חוזה וגרסת מוצר",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/capabilities",
      "operation_id": "capabilities",
      "summary_he": "יכולות זמינות ב-Core",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/bootstrap",
      "operation_id": "bootstrap",
      "summary_he": "תמונת אתחול בטוחה לשולחן העבודה",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/workspaces",
      "operation_id": "listWorkspaces",
      "summary_he": "רשימת סביבות עבודה",
      "request_schema": null
    },
    {
      "method": "POST",
      "path": "/v2/workspaces",
      "operation_id": "createWorkspace",
      "summary_he": "יצירת סביבת עבודה",
      "request_schema": "createWorkspace"
    },
    {
      "method": "PATCH",
      "path": "/v2/workspaces/{workspace_id}",
      "operation_id": "patchWorkspace",
      "summary_he": "עדכון סביבת עבודה",
      "request_schema": "patchWorkspace"
    },
    {
      "method": "DELETE",
      "path": "/v2/workspaces/{workspace_id}",
      "operation_id": "deleteWorkspace",
      "summary_he": "מחיקת סביבת עבודה",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/conversations",
      "operation_id": "listConversations",
      "summary_he": "רשימה וחיפוש שיחות",
      "request_schema": null
    },
    {
      "method": "POST",
      "path": "/v2/conversations",
      "operation_id": "createConversation",
      "summary_he": "יצירת שיחה",
      "request_schema": "createConversation"
    },
    {
      "method": "GET",
      "path": "/v2/conversations/{session_id}",
      "operation_id": "getConversation",
      "summary_he": "פרטי שיחה",
      "request_schema": null
    },
    {
      "method": "PATCH",
      "path": "/v2/conversations/{session_id}",
      "operation_id": "patchConversation",
      "summary_he": "שינוי שם, שיוך או נעיצה",
      "request_schema": "patchConversation"
    },
    {
      "method": "DELETE",
      "path": "/v2/conversations/{session_id}",
      "operation_id": "deleteConversation",
      "summary_he": "מחיקת שיחה",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/conversations/{session_id}/messages",
      "operation_id": "listMessages",
      "summary_he": "הודעות בעימוד",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/conversations/{session_id}/export",
      "operation_id": "exportConversation",
      "summary_he": "ייצוא JSON בסמכות היסטוריית Smarti",
      "request_schema": null
    },
    {
      "method": "POST",
      "path": "/v2/conversations/{session_id}/runs",
      "operation_id": "submitRun",
      "summary_he": "שליחת בקשה לסוכן",
      "request_schema": "submitRun"
    },
    {
      "method": "POST",
      "path": "/v2/conversations/{session_id}/read",
      "operation_id": "markRead",
      "summary_he": "סימון תשומת לב כנקראה",
      "request_schema": "markRead"
    },
    {
      "method": "GET",
      "path": "/v2/runs",
      "operation_id": "listRuns",
      "summary_he": "רשימת ריצות",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/runs/{run_id}",
      "operation_id": "getRun",
      "summary_he": "מצב ריצה",
      "request_schema": null
    },
    {
      "method": "POST",
      "path": "/v2/runs/{run_id}/cancel",
      "operation_id": "cancelRun",
      "summary_he": "בקשת ביטול",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/runs/{run_id}/events",
      "operation_id": "replayRunEvents",
      "summary_he": "שחזור אירועי ריצה",
      "request_schema": null
    },
    {
      "method": "POST",
      "path": "/v2/runs/{run_id}/api-key",
      "operation_id": "provideRunApiKey",
      "summary_he": "מענה להפרעת מפתח API של ריצה",
      "request_schema": "provideRunApiKey"
    },
    {
      "method": "GET",
      "path": "/v2/events/replay",
      "operation_id": "replayEventsHttp",
      "summary_he": "שחזור אירועים עמיד דרך מארח Tauri",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/approvals",
      "operation_id": "listApprovals",
      "summary_he": "אישורים ממתינים",
      "request_schema": null
    },
    {
      "method": "POST",
      "path": "/v2/approvals/{approval_id}/resolve",
      "operation_id": "resolveApproval",
      "summary_he": "אישור או דחייה",
      "request_schema": "resolveApproval"
    },
    {
      "method": "GET",
      "path": "/v2/settings/schema",
      "operation_id": "settingsSchema",
      "summary_he": "סכמת הגדרות בטוחה",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/settings",
      "operation_id": "getSettings",
      "summary_he": "ערכים לא סודיים ומצב סודות ממוסך",
      "request_schema": null
    },
    {
      "method": "PATCH",
      "path": "/v2/settings",
      "operation_id": "patchSettings",
      "summary_he": "עדכון הגדרות לא סודיות",
      "request_schema": "patchSettings"
    },
    {
      "method": "PUT",
      "path": "/v2/settings/secrets/{secret_key}",
      "operation_id": "setSecret",
      "summary_he": "שמירת סוד",
      "request_schema": "setSecret"
    },
    {
      "method": "DELETE",
      "path": "/v2/settings/secrets/{secret_key}",
      "operation_id": "deleteSecret",
      "summary_he": "מחיקת סוד",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/management/legal",
      "operation_id": "legalStatus",
      "summary_he": "מצב שער ההסכמה המשפטית",
      "request_schema": null
    },
    {
      "method": "POST",
      "path": "/v2/management/legal",
      "operation_id": "acceptLegal",
      "summary_he": "הסכמה מפורשת למסמך המשפטי הנוכחי",
      "request_schema": "legalAcceptance"
    },
    {
      "method": "POST",
      "path": "/v2/management/settings/actions",
      "operation_id": "settingsAction",
      "summary_he": "זרימות הגדרות ייעודיות ובדיקות חיבור",
      "request_schema": "settingsAction"
    },
    {
      "method": "POST",
      "path": "/v2/providers/{provider}/validate",
      "operation_id": "validateProvider",
      "summary_he": "בדיקת ספק וגילוי מודלים",
      "request_schema": "validateProvider"
    },
    {
      "method": "GET",
      "path": "/v2/providers/{provider}/models",
      "operation_id": "discoverModels",
      "summary_he": "גילוי מודלים",
      "request_schema": null
    },
    {
      "method": "GET",
      "path": "/v2/providers/{provider}/reasoning",
      "operation_id": "getModelReasoning",
      "summary_he": "קריאת רמות חשיבה למודל",
      "request_schema": null
    },
    {
      "method": "POST",
